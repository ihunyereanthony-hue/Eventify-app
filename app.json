{
  "expo": {
    "name": "Eventify-app",
    "slug": "Eventify-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/eventify-icon.png",
    "scheme": "eventifyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/splash-eventify-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tony_marshal.Eventifyapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/faveventify-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-eventify-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b231aacc-3636-463a-adfe-29fd7a818eef"
      }
    }
  }
}
